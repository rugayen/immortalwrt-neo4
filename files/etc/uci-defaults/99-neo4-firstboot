#!/bin/sh
# 首次启动兜底配置。
# 网络/DHCP/防火墙/无线/apk 源/rc.local 的最终态已由 files/etc/... 直接注入 rootfs，
# 这里只补主机名与 LuCI 语言，并保留守卫：配置尚未就绪时退出 1，
# uci-defaults 会保留本脚本，下次启动再试。

if ! uci -q get network.lan >/dev/null 2>&1; then
    logger -t neo4-firstboot "network.lan 未就绪，下次启动重试"
    exit 1
fi

uci -q set system.@system[0].hostname='NEO4'
# LuCI 简体中文：dispatcher 读 luci.main.lang 并把 '_' 转成 '-' 加载 *.zh-cn.lmo
uci -q set luci.main.lang='zh_cn'
uci commit

logger -t neo4-firstboot "hostname=NEO4 lang=zh_cn 已设置"
exit 0
